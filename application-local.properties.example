# Copy to application-local.properties in this directory (gitignored).
# Do not commit the copy. Committed freeze stays ibm-granite/granite-3.2-8b-instruct
# with questshift.llm.api-key=none.
#
# Prefix keys with %dev. so ./mvnw quarkus:dev can talk to a live OpenAI-compatible
# endpoint while %test (./mvnw test / verify) stays YAML-only.
#
# Cluster / workshop runtime is still vLLM + Granite 3.2 8B Instruct on NVIDIA L4.
# For a workshop MaaS /v1/chat/completions gateway: set base-url to that host's /v1,
# model to the gateway's Granite id, and api-key to the Bearer token from the UI.
# Never paste workshop hostnames or tokens into git.

%dev.questshift.llm.enabled=true
%dev.questshift.llm.base-url=http://127.0.0.1:18000/v1
%dev.questshift.llm.model=ibm-granite/granite-3.2-8b-instruct
%dev.questshift.llm.api-key=none
%dev.questshift.llm.timeout-seconds=120
