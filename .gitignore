# Local secrets — never commit Hugging Face tokens or LLM API keys
.env
.env.*
application-local.properties
application-secret.properties

# Local pre-commit overrides (copy from .githooks/config.example)
.githooks/config
*.pem
id_rsa
id_ed25519

# Compiled class file
*.class

target/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
